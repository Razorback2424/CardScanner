{
  "hosting": [
    {
      "target": "production",
      "public": "publisher/site",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "/market-prices/v2/latest.json",
          "headers": [
            {"key": "Cache-Control", "value": "no-cache"},
            {"key": "Content-Type", "value": "application/json; charset=utf-8"}
          ]
        },
        {
          "source": "/market-prices/v2/history.json",
          "headers": [
            {"key": "Cache-Control", "value": "no-cache"},
            {"key": "Content-Type", "value": "application/json; charset=utf-8"}
          ]
        },
        {
          "source": "/market-prices/v2/builds/*/index.json",
          "headers": [
            {"key": "Cache-Control", "value": "public,max-age=31536000,immutable"},
            {"key": "Content-Type", "value": "application/json; charset=utf-8"}
          ]
        },
        {
          "source": "/market-prices/v2/builds/*/tcgplayer/**",
          "headers": [
            {"key": "Cache-Control", "value": "public,max-age=31536000,immutable"},
            {"key": "Content-Type", "value": "application/json; charset=utf-8"}
          ]
        },
        {
          "source": "/market-prices/v2/builds/*/scopes/*.json",
          "headers": [
            {"key": "Cache-Control", "value": "public,max-age=31536000,immutable"},
            {"key": "Content-Type", "value": "application/json; charset=utf-8"}
          ]
        },
        {
          "source": "/market-prices/v2/builds/*/last-updated.txt",
          "headers": [
            {"key": "Cache-Control", "value": "public,max-age=31536000,immutable"},
            {"key": "Content-Type", "value": "text/plain; charset=utf-8"}
          ]
        },
        {
          "source": "/market-prices/v2/verified-builds/*.json",
          "headers": [
            {"key": "Cache-Control", "value": "public,max-age=31536000,immutable"},
            {"key": "Content-Type", "value": "application/json; charset=utf-8"}
          ]
        },
        {
          "source": "/market-prices/v1/last-updated.txt",
          "headers": [{"key": "Cache-Control", "value": "no-cache"}]
        },
        {
          "source": "/market-prices/v1/index.json",
          "headers": [
            {"key": "Cache-Control", "value": "public,max-age=300"}
          ]
        },
        {
          "source": "/market-prices/v1/tcgplayer/**",
          "headers": [
            {"key": "Cache-Control", "value": "public,max-age=300"},
            {"key": "Content-Type", "value": "application/json; charset=utf-8"}
          ]
        },
        {
          "source": "/yugioh/v1/market-price-scope.json",
          "headers": [{"key": "Cache-Control", "value": "no-cache"}]
        },
        {
          "source": "/one-piece/v1/market-price-scope.json",
          "headers": [{"key": "Cache-Control", "value": "no-cache"}]
        },
        {
          "source": "/yugioh/v1/current.json",
          "headers": [{"key": "Cache-Control", "value": "no-cache"}]
        },
        {
          "source": "/yugioh/v1/releases/**",
          "headers": [{"key": "Cache-Control", "value": "public,max-age=31536000,immutable"}]
        },
        {
          "source": "/one-piece/v1/current.json",
          "headers": [{"key": "Cache-Control", "value": "no-cache"}]
        },
        {
          "source": "/one-piece/v1/releases/**",
          "headers": [{"key": "Cache-Control", "value": "public,max-age=31536000,immutable"}]
        },
        {
          "source": "/v1/current.json",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/v1/releases/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public,max-age=31536000,immutable"
            }
          ]
        },
        {
          "source": "/magic/v1/current.json",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/magic/v1/releases/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public,max-age=31536000,immutable"
            }
          ]
        }
      ]
    }
  ],
  "functions": [
    {
      "source": "pricing-proxy",
      "codebase": "pricing",
      "runtime": "nodejs22",
      "ignore": ["node_modules", "test", ".gitignore", "*.local"],
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
    }
  ],
  "firestore": {"rules": "pricing-proxy/firestore.rules"}
}
