{
  "hosting": [
    {
      "target": "production",
      "public": "publisher/site",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "/market-prices/v1/**",
          "headers": [
            {"key": "Cache-Control", "value": "public,max-age=300"}
          ]
        },
        {
          "source": "/market-prices/v1/tcgplayer/**",
          "headers": [{"key": "Content-Type", "value": "application/json; charset=utf-8"}]
        },
        {
          "source": "/yugioh/v1/current.json",
          "headers": [{"key": "Cache-Control", "value": "no-cache"}]
        },
        {
          "source": "/yugioh/v1/releases/**",
          "headers": [{"key": "Cache-Control", "value": "public,max-age=31536000,immutable"}]
        },
        {
          "source": "/one-piece/v1/current.json",
          "headers": [{"key": "Cache-Control", "value": "no-cache"}]
        },
        {
          "source": "/one-piece/v1/releases/**",
          "headers": [{"key": "Cache-Control", "value": "public,max-age=31536000,immutable"}]
        },
        {
          "source": "/v1/current.json",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/v1/releases/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public,max-age=31536000,immutable"
            }
          ]
        },
        {
          "source": "/magic/v1/current.json",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/magic/v1/releases/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public,max-age=31536000,immutable"
            }
          ]
        }
      ]
    }
  ]
}
