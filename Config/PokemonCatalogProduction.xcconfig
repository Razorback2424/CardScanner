// Production catalog configuration used for the gated Slice F rollout.
// Rollout mode is selected explicitly below for each deployment stage.
// `/$()/` keeps the xcconfig parser from treating the URL's `//` as a
// comment; Xcode expands the empty variable reference back to `https://`.
POKEMON_CATALOG_BASE_URL = https:/$()/catalog.scan-stash.com
POKEMON_CATALOG_ALLOWED_ORIGIN_HOST = catalog.scan-stash.com
// Shared daily market feed for reviewed product/finish mappings across games.
// Keep production v1 until the v2 publisher and Firebase rollback path are proven.
// For staging validation, override TCGCSV_PRICE_BASE_URL with the staging v2 URL.
TCGCSV_PRICE_BASE_URL = https:/$()/catalog.scan-stash.com/market-prices/v1
// Operator-funded JustTCG pricing proxy (pricing-proxy/). Leave empty until
// launch preparation: empty keeps the developer customer-key path; setting it
// (https, ending in /v1/justtcg) routes all JustTCG traffic through the proxy.
JUSTTCG_PROXY_BASE_URL =
// Firebase App Check for the proxy (PricingAppCheck): the Firebase iOS app ID
// (1:<project number>:ios:<hex>) and its API key, set with the proxy URL at
// launch preparation. Empty means requests carry no App Check token.
PRICING_APP_CHECK_APP_ID =
PRICING_APP_CHECK_API_KEY =
// Set these only after the owner-approved public pages are published and
// verified. Target settings must not override this release configuration.
CARD_SCANNER_PRIVACY_URL =
CARD_SCANNER_SUPPORT_URL =
POKEMON_CATALOG_ROLLOUT_MODE = remote-authority
// Public key material is pinned for production signature verification, for
// example: production-v1:<base64url-32-byte-public-key>
POKEMON_CATALOG_PINNED_KEYS = pokemon-catalog-production-2026-09-18-01:CEQfURmtxBTE170BLAk1hVcKgBmGAgVlR7hhSgO6CLI
#include "MagicCatalogProduction.xcconfig"
#include "OnePieceCatalogProduction.xcconfig"
