// Production catalog configuration used for the gated Slice F rollout.
// Rollout mode is selected explicitly below for each deployment stage.
// `/$()/` keeps the xcconfig parser from treating the URL's `//` as a
// comment; Xcode expands the empty variable reference back to `https://`.
POKEMON_CATALOG_BASE_URL = https:/$()/catalog.scan-stash.com
POKEMON_CATALOG_ALLOWED_ORIGIN_HOST = catalog.scan-stash.com
POKEMON_CATALOG_ROLLOUT_MODE = bundled-validation-only
// Public key material is pinned for production signature verification, for
// example: production-v1:<base64url-32-byte-public-key>
POKEMON_CATALOG_PINNED_KEYS = pokemon-catalog-production-2026-09-18-01:CEQfURmtxBTE170BLAk1hVcKgBmGAgVlR7hhSgO6CLI
